# Production deployment template (competition environment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key_here
NEXT_PUBLIC_APP_URL=https://your-app-domain.com
NEXT_PUBLIC_RALION_API_URL=https://your-api-domain.com

# AMD Inference Service
AMD_ROCM_ENABLED=true
AMD_VLLM_ENDPOINT=http://your-amd-vllm-host:8000/v1
AMD_DEFAULT_MODEL=amd/rocm-vllm-instruct
