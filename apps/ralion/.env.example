# ==============================================================================
# Ralion OS — AMD Developer Hackathon ACT III Environment Template
# ==============================================================================
# All values below are safe placeholders for isolated hackathon development.
# CRITICAL SAFETY RULE: Never configure production project IDs (e.g. yidsfihagwttlmhfynmf)
# or live corporate production endpoints. Any attempt to use them is rejected at startup.
# ==============================================================================

# Isolated Mode (set to true to use synthetic fixtures and mock external integrations)
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Dedicated Hackathon Supabase Project (or local Supabase: http://localhost:54321)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_hackathon_supabase_publishable_key_placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_hackathon_supabase_anon_key_placeholder
SUPABASE_SECRET_KEY=your_hackathon_supabase_secret_key_placeholder

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:6509
NEXT_PUBLIC_RALION_API_URL=http://localhost:6509

# ----- AMD Token Factory & ROCm vLLM Compute (Exclusively Server-Side) -----
RADEON_API_KEY=your_radeon_token_factory_api_key_placeholder
AMD_ROCM_ENABLED=true
AMD_VLLM_ENDPOINT=http://localhost:8000/v1
AMD_DEFAULT_MODEL=amd/rocm-vllm-instruct
AMD_GPU_DEVICE=AMD Instinct MI300X (ROCm 6.2)

# ----- AI Providers (Preserved for evaluation) -----
GEMINI_API_KEY=your_gemini_api_key_placeholder
AIML_API_KEY=your_aiml_api_key_placeholder

# ----- External Integration Placeholders (Disabled/Mocked in Demo Mode) -----
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_placeholder
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_placeholder
FACEBOOK_APP_ID=your_facebook_app_id_placeholder
FACEBOOK_APP_SECRET=your_facebook_app_secret_placeholder
