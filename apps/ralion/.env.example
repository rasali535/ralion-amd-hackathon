# Ralion OS — AMD Developer Hackathon ACT III Edition Environment Configuration

# Isolated Mode (set to true to use synthetic fixtures and mock external integrations)
DEMO_MODE=true

# Supabase (Isolated development or local Supabase)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder
SUPABASE_SECRET_KEY=your_supabase_secret_key_placeholder

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:6509
NEXT_PUBLIC_RALION_API_URL=http://localhost:6509

# ----- AMD ROCm / vLLM Inference Service -----
AMD_ROCM_ENABLED=true
AMD_VLLM_ENDPOINT=http://localhost:8000/v1
AMD_DEFAULT_MODEL=amd/rocm-vllm-instruct
AMD_GPU_DEVICE=AMD Instinct / Radeon ROCm

# ----- AI Providers (Preserved for comparison) -----
GEMINI_API_KEY=your_gemini_api_key_placeholder
AIML_API_KEY=your_aiml_api_key_placeholder

# ----- External Integration Mocks (Disabled/Mocked in Demo Mode) -----
# PayPal Live Billing
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_placeholder
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_placeholder

# Meta / Social (Mocked in Demo Mode)
FACEBOOK_APP_ID=your_facebook_app_id_placeholder
FACEBOOK_APP_SECRET=your_facebook_app_secret_placeholder
